SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=1

# Hosts & CORS
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database — set DB_CHOICE=postgres for production (Neon, Railway, Supabase)
DB_CHOICE=sqlite
DATABASE_URL=postgresql://user:password@host:5432/schoolrun

# Site
SITE_NAME=SchoolRun

# Email (uncomment and configure for production)
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@schoolrun.ng
# EMAIL_HOST_PASSWORD=your-email-password
# EMAIL_PORT=587

# Redis (for Celery task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Admin bootstrap credentials
ADMIN_EMAIL=admin@schoolrun.ng
ADMIN_PASSWORD=ChangeThisSecurePassword123