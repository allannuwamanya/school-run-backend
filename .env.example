SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=1

# Hosts & CORS
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database — set DB_CHOICE=postgres for production (Neon, Railway, Supabase).
# Neon: use the DIRECT (non-pooled) connection string, not the "-pooler" one —
# Django's persistent connections (conn_max_age) don't pair well with
# PgBouncer transaction-mode pooling. Requires ?sslmode=require. Before the
# first migrate, enable PostGIS on the target database:
#   psql "$DATABASE_URL" -c "CREATE EXTENSION IF NOT EXISTS postgis;"
DB_CHOICE=sqlite
DATABASE_URL=postgresql://user:password@host:5432/schoolrun?sslmode=require

# GDAL/GEOS (Windows local dev only — enables real PostGIS geography columns
# instead of the varchar fallback in main/gis_fallback.py). Install via
# `winget install GISInternals.GDAL`, then point these at the install dir.
# Leave unset on Linux/production; Django auto-discovers the apt-installed
# .so files there (see the Dockerfile).
# GDAL_LIBRARY_PATH=C:\Program Files\GDAL\gdal.dll
# GEOS_LIBRARY_PATH=C:\Program Files\GDAL\geos_c.dll
# GDAL_DATA=C:\Program Files\GDAL\gdal-data
# PROJ_LIB=C:\Program Files\GDAL\projlib

# Firebase Push Notifications
# Either set FIREBASE_SERVICE_ACCOUNT_PATH to a downloaded JSON file, or
# paste the entire JSON as a single line in FIREBASE_SERVICE_ACCOUNT_JSON.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Sign-In (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application). This is the Client ID only, never the
# client secret — the ID-token verification flow doesn't need the secret.
GOOGLE_CLIENT_ID=

# Site
SITE_NAME=SchoolRun

# Firebase Admin SDK — required to deliver device push notifications
# (main/firebase_push.py). Without it, _init() can't initialize and
# send_push() silently no-ops: in-app notifications still save, but no
# heads-up push reaches the device. Get the key from the Firebase console
# (project schoolrun-5201b → Project settings → Service accounts →
# Generate new private key). Provide EITHER the path to the downloaded
# file OR its full JSON contents inline (path wins if both are set):
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"schoolrun-5201b",...}

# Email (uncomment and configure for production)
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@schoolrun.ng
# EMAIL_HOST_PASSWORD=your-email-password
# EMAIL_PORT=587

# Redis (for Celery task queue)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Admin bootstrap credentials
ADMIN_EMAIL=admin@schoolrun.ng
ADMIN_PASSWORD=ChangeThisSecurePassword123