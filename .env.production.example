# Production .env for the VPS (schoolrun.oddshoesdev.xyz).
# Copy to `.env` on the server and fill in real values. NEVER commit the
# filled-in .env (it's gitignored). Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Core ---
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
DEBUG=0
ALLOWED_HOSTS=schoolrun.oddshoesdev.xyz,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://schoolrun.oddshoesdev.xyz
CORS_ALLOWED_ORIGINS=https://schoolrun.oddshoesdev.xyz
SITE_NAME=SchoolRun

# --- Database (self-hosted Postgres/PostGIS container) ---
DB_CHOICE=postgres
# These three configure the schoolrun-postgres container...
POSTGRES_DB=schoolrun
POSTGRES_USER=schoolrun
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
# ...and this is how Django reaches it (host = the compose service name).
# Keep the password identical to POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://schoolrun:REPLACE_WITH_A_STRONG_DB_PASSWORD@schoolrun-postgres:5432/schoolrun

# --- Celery (Redis container, reached by service name) ---
CELERY_BROKER_URL=redis://schoolrun-redis:6379/0
CELERY_RESULT_BACKEND=redis://schoolrun-redis:6379/0

# --- Google Sign-In (ID-token verification only; no client secret) ---
GOOGLE_CLIENT_ID=754140346758-dp22032uo8nf5l1filmn1a2n6t39n3d4.apps.googleusercontent.com

# --- Firebase Admin SDK (push delivery) ---
# Paste the whole service-account JSON on one line, or use the _PATH form
# with a file mounted into the container. Without it, push silently no-ops.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Admin bootstrap (entrypoint.sh creates this superuser on first boot) ---
ADMIN_EMAIL=admin@oddshoesdev.xyz
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
